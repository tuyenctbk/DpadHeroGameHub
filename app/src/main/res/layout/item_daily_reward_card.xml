<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/daily_reward_card_root"
    android:layout_width="100dp"
    android:layout_height="130dp"
    android:layout_margin="6dp"
    android:background="@drawable/game_item_background"
    android:backgroundTint="#1B263B"
    android:clickable="false"
    android:focusable="false"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/reward_day_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/day_1"
        android:textColor="#90A4AE"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/reward_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/ic_coin" />

    <TextView
        android:id="@+id/reward_coin_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+100"
        android:textColor="#FFD700"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/reward_status_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/status_locked"
        android:textColor="#78909C"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>
