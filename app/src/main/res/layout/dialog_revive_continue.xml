<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/revive_root_container"
    android:layout_width="480dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/dialog_background"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="26dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Glowing Heart / Extra Life Icon Header -->
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="12dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_reward_heart_glow" />

        <ImageView
            android:id="@+id/iv_revive_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_avatar_heart"
            app:tint="#FF1744" />
    </FrameLayout>

    <!-- Arcade 2nd Chance Pill Tag -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2ND CHANCE OFFER"
        android:textColor="#FFD700"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:background="@drawable/bg_reward_pill_tag"
        android:layout_marginBottom="10dp" />

    <!-- Countdown Title -->
    <TextView
        android:id="@+id/tv_revive_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/continue_countdown"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:gravity="center"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="6"
        android:layout_marginBottom="8dp" />

    <!-- Subtitle / Instruction -->
    <TextView
        android:id="@+id/tv_revive_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/revive_prompt_description"
        android:textColor="#B0BEC5"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.2"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Perk Highlights Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="10dp"
        android:background="@drawable/bg_reward_perks_card"
        android:layout_marginBottom="20dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_hero_shield"
            app:tint="#00E676"
            android:layout_marginEnd="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+1 Extra Life • Keep Current Score"
            android:textColor="#00E676"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Option 1: Watch Ad to Continue (Default Focus) -->
    <Button
        android:id="@+id/btn_revive_continue"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="@string/btn_revive_continue"
        android:background="@drawable/bg_btn_green_selector"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"
        android:elevation="4dp"
        android:focusable="true"
        android:nextFocusUp="@id/btn_revive_give_up"
        android:nextFocusDown="@id/btn_revive_give_up"
        android:layout_marginBottom="10dp" />

    <!-- Option 2: End Game -->
    <Button
        android:id="@+id/btn_revive_give_up"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="@string/btn_revive_give_up"
        android:background="@drawable/bg_btn_neutral_selector"
        android:textColor="#B0BEC5"
        android:textSize="14sp"
        android:textStyle="bold"
        android:focusable="true"
        android:nextFocusUp="@id/btn_revive_continue"
        android:nextFocusDown="@id/btn_revive_continue" />

</LinearLayout>
