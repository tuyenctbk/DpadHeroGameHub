<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/revive_root_container"
    android:layout_width="520dp"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:orientation="vertical"
    android:padding="28dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Header / Countdown Title -->
    <TextView
        android:id="@+id/tv_revive_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/continue_countdown"
        android:textColor="#FFD700"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:gravity="center"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="6"
        android:layout_marginBottom="12dp" />

    <!-- Subtitle / Instruction -->
    <TextView
        android:id="@+id/tv_revive_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/revive_prompt_description"
        android:textColor="#B0BEC5"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#44FFFFFF"
        android:layout_marginBottom="20dp" />

    <!-- Option 1: Watch Ad to Continue -->
    <Button
        android:id="@+id/btn_revive_continue"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/btn_revive_continue"
        android:background="@drawable/bg_menu_item_selector"
        android:textColor="@color/btn_menu_text_selector"
        android:textSize="18sp"
        android:textStyle="bold"
        android:elevation="4dp"
        android:focusable="true"
        android:nextFocusDown="@+id/btn_revive_give_up"
        android:layout_marginBottom="12dp" />

    <!-- Option 2: End Game -->
    <Button
        android:id="@+id/btn_revive_give_up"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/btn_revive_give_up"
        android:background="@drawable/bg_menu_item_selector"
        android:textColor="@color/btn_menu_text_selector"
        android:textSize="18sp"
        android:textStyle="bold"
        android:elevation="4dp"
        android:focusable="true"
        android:nextFocusUp="@+id/btn_revive_continue" />

</LinearLayout>
