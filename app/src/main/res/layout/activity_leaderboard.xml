<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">

    <com.tdpham.games.hub.BackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.7" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Top Header & Global/Local Mode Switcher -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_trophy"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/leaderboard_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/hall_of_fame"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- Local vs Global Toggle Buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/game_item_background"
                android:backgroundTint="#141C2E"
                android:padding="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_mode_local"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/game_item_background"
                    android:backgroundTint="#00E5FF"
                    android:text="🏠 LOCAL"
                    android:textColor="#0A0E17"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />

                <Button
                    android:id="@+id/btn_mode_global"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/game_item_background"
                    android:backgroundTint="#22FFFFFF"
                    android:text="🌐 WORLDWIDE"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:layout_marginStart="6dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />
            </LinearLayout>
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/game_tab_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:id="@+id/game_tabs_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <include layout="@layout/layout_leaderboard_podium" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadeScrollbars="false"
            android:scrollbarThumbVertical="@drawable/game_item_background">
            <LinearLayout
                android:id="@+id/scores_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp" />
        </ScrollView>

        <Button
            android:id="@+id/btn_back"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="@string/back"
            android:background="@drawable/game_item_background"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:elevation="4dp" />

    </LinearLayout>
</RelativeLayout>
