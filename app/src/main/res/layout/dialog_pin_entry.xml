<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="420dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/dialog_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <TextView
        android:id="@+id/pin_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/enter_pin"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/security_pin_label"
        android:textColor="#88FFFFFF"
        android:textSize="13sp"
        android:layout_marginBottom="20dp" />

    <EditText
        android:id="@+id/edit_pin"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:background="@drawable/game_item_background"
        android:backgroundTint="#22FFFFFF"
        android:gravity="center"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:padding="16dp"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:letterSpacing="0.8"
        android:focusable="true" />

    <TextView
        android:id="@+id/pin_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/wrong_pin"
        android:textColor="#FF5252"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="invisible" />

</LinearLayout>
