<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Deep Gradient Background -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/main_background_gradient" />

    <!-- Animated Dynamic Background -->
    <com.tdpham.games.hub.BackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.7" />

    <!-- Retro Scanline Overlay -->
    <View
        android:id="@+id/main_scanline_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scanline_pattern"
        android:alpha="0.15" />

    <!-- Top Navigation Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="32dp"
        android:clipChildren="false">

        <!-- Player Badge (Icon + Name) -->
        <LinearLayout
            android:id="@+id/active_profile_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/game_item_background"
            android:backgroundTint="#22FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:elevation="8dp">

            <!-- Avatar Icon (No colored circle background) -->
            <ImageView
                android:id="@+id/active_profile_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_avatar_smile" />

            <TextView
                android:id="@+id/active_profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/placeholder_name"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

        </LinearLayout>

        <!-- Top Right Action Buttons: Coins/Daily Reward, Rate, Share, Hall of Fame, Settings -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Daily Rewards / Coin Chip Button -->
            <LinearLayout
                android:id="@+id/btn_daily_reward"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/game_item_background"
                android:backgroundTint="#FFD700"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:elevation="6dp"
                android:nextFocusLeft="@id/active_profile_layout"
                android:nextFocusRight="@id/btn_rate"
                android:nextFocusDown="@id/btn_snake">

                <ImageView
                    android:id="@+id/iv_daily_reward_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_gift" />

                <TextView
                    android:id="@+id/tv_main_coins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="100"
                    android:textColor="#0A0E17"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Rate App Button -->
            <Button
                android:id="@+id/btn_rate"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/game_item_background"
                android:backgroundTint="#22FFFFFF"
                android:drawableTop="@drawable/ic_star_rate"
                android:paddingTop="16dp"
                android:focusable="true"
                android:nextFocusLeft="@id/btn_daily_reward"
                android:nextFocusRight="@id/btn_share"
                android:nextFocusDown="@id/btn_snake" />

            <!-- Share App Button -->
            <Button
                android:id="@+id/btn_share"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/game_item_background"
                android:backgroundTint="#22FFFFFF"
                android:drawableTop="@drawable/ic_share"
                android:paddingTop="16dp"
                android:focusable="true"
                android:nextFocusLeft="@id/btn_rate"
                android:nextFocusRight="@id/btn_leaderboard"
                android:nextFocusDown="@id/btn_snake" />

            <!-- Hall of Fame Icon -->
            <Button
                android:id="@+id/btn_leaderboard"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/game_item_background"
                android:backgroundTint="#22FFFFFF"
                android:drawableTop="@drawable/ic_trophy"
                android:paddingTop="16dp"
                android:focusable="true"
                android:nextFocusLeft="@id/btn_share"
                android:nextFocusRight="@id/btn_settings"
                android:nextFocusDown="@id/btn_snake" />

            <!-- Settings Button -->
            <Button
                android:id="@+id/btn_settings"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/game_item_background"
                android:backgroundTint="#22FFFFFF"
                android:drawableTop="@drawable/ic_settings"
                android:paddingTop="16dp"
                android:focusable="true"
                android:nextFocusLeft="@id/btn_leaderboard"
                android:nextFocusDown="@id/btn_snake" />

        </LinearLayout>


    </RelativeLayout>

