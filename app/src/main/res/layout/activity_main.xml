                android:text="@string/game_mental_math"
                android:textAllCaps="true"
                android:drawableTop="@drawable/ic_game_mental_math"
                android:paddingTop="32dp"
                android:drawablePadding="16dp"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_road_racer"
                android:layout_width="200dp"
                android:layout_height="240dp"
                android:layout_marginStart="32dp"
                android:background="@drawable/game_item_background"
                android:backgroundTint="@color/btn_road_racer_color"
                android:elevation="12dp"
                android:focusable="true"
                android:text="@string/game_road_racer"
                android:textAllCaps="true"
                android:drawableTop="@drawable/ic_game_road_racer"
                android:paddingTop="32dp"
                android:drawablePadding="16dp"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_fruit"
                android:layout_width="200dp"
                android:layout_height="240dp"
                android:layout_marginStart="32dp"
                android:background="@drawable/game_item_background"
                android:backgroundTint="@color/btn_fruit_color"
                android:elevation="12dp"
                android:focusable="true"
                android:text="@string/game_fruit"
                android:textAllCaps="true"
                android:drawableTop="@drawable/ic_game_fruit"
                android:paddingTop="32dp"
                android:drawablePadding="16dp"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_connect_four"
                android:layout_width="200dp"
                android:layout_height="240dp"
                android:layout_marginStart="32dp"
                android:background="@drawable/game_item_background"
                android:backgroundTint="@color/btn_connect_four_color"
                android:elevation="12dp"
                android:focusable="true"
                android:text="@string/game_connect_four"
                android:textAllCaps="true"
                android:drawableTop="@drawable/ic_game_connect_four"
                android:paddingTop="32dp"
                android:drawablePadding="16dp"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_blackjack"
                android:layout_width="200dp"
                android:layout_height="240dp"
                android:layout_marginStart="32dp"
                android:background="@drawable/game_item_background"
                android:backgroundTint="@color/btn_blackjack_color"
                android:elevation="12dp"
                android:focusable="true"
                android:text="@string/game_blackjack"
                android:textAllCaps="true"
                android:drawableTop="@drawable/ic_game_blackjack"
                android:paddingTop="32dp"
                android:drawablePadding="16dp"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_trivia"
                android:layout_width="200dp"
                android:layout_height="240dp"
                android:layout_marginStart="32dp"
                android:background="@drawable/game_item_background"
                android:backgroundTint="@color/btn_trivia_color"
                android:elevation="12dp"
                android:focusable="true"
                android:text="@string/game_trivia"
                android:textAllCaps="true"
                android:drawableTop="@drawable/ic_game_trivia"
                android:paddingTop="32dp"
                android:drawablePadding="16dp"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Real-Time Global Leaderboard Widget -->
    <LinearLayout
        android:id="@+id/live_leaderboard_widget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/game_item_background"
        android:backgroundTint="#162035"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:elevation="10dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Widget Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_widget_live_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/game_item_background"
                android:backgroundTint="#FF1744"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="● LIVE"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_widget_game_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="GLOBAL TOP 3 • SNAKE"
                android:textColor="#00E5FF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HALL OF FAME 🏆"
                android:textColor="#FFD700"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Top 3 Podium Slots -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 1st Place Slot -->
            <LinearLayout
                android:id="@+id/widget_slot_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/game_item_background"
                android:backgroundTint="#1F2C47"
                android:orientation="horizontal"
                android:padding="8dp"
                android:layout_marginEnd="6dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="#FFD700"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="#0A0E17"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_avatar_1"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_avatar_smile" />

                <TextView
                    android:id="@+id/widget_name_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="---"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_score_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="0 pts"
                    android:textColor="#FFD700"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2nd Place Slot -->
            <LinearLayout
                android:id="@+id/widget_slot_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/game_item_background"
                android:backgroundTint="#1F2C47"
                android:orientation="horizontal"
                android:padding="8dp"
                android:layout_marginEnd="6dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="#E0E0E0"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="#0A0E17"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_avatar_2"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_avatar_smile" />

                <TextView
                    android:id="@+id/widget_name_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="---"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_score_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="0 pts"
                    android:textColor="#E0E0E0"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 3rd Place Slot -->
            <LinearLayout
                android:id="@+id/widget_slot_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/game_item_background"
                android:backgroundTint="#1F2C47"
                android:orientation="horizontal"
                android:padding="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="#CD7F32"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_avatar_3"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_avatar_smile" />

                <TextView
                    android:id="@+id/widget_name_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="---"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_score_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="0 pts"
                    android:textColor="#CD7F32"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/hero_customization_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/hero_customization_hint"
        android:textColor="#FFCA28"
        android:textSize="16sp"
        android:textStyle="bold"
        android:shadowColor="#80000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:visibility="gone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="@string/select_game_hint"
        android:textColor="#99FFFFFF"
        android:textSize="18sp"
        android:shadowColor="#80000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="2" />

    </LinearLayout>
</RelativeLayout>
