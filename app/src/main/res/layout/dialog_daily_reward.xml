<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/daily_reward_dialog_root"
    android:layout_width="680dp"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:backgroundTint="#0E1626"
    android:orientation="vertical"
    android:padding="28dp"
    android:gravity="center_horizontal">

    <!-- Header / Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_gift" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/daily_arcade_rewards"
                android:textColor="#FFD700"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tv_streak_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/daily_rewards_subtitle"
                android:textColor="#90A4AE"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Current Coins Balance Chip -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/game_item_background"
            android:backgroundTint="#1B263B"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_coin" />

            <TextView
                android:id="@+id/tv_dialog_coin_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="100"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- 7-Day Rewards Horizontal Container -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:id="@+id/rewards_cards_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btn_claim_reward"
            android:layout_width="260dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_menu_item_selector"
            android:text="@string/claim_reward"
            android:textColor="@color/btn_menu_text_selector"
            android:textSize="16sp"
            android:textStyle="bold"
            android:focusable="true" />

        <Button
            android:id="@+id/btn_close_daily_reward"
            android:layout_width="140dp"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_btn_neutral_selector"
            android:text="@string/btn_close"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
