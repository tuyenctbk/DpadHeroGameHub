<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">

    <!-- Deep Gradient Background -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/main_background_gradient" />

    <!-- Animated Dynamic Background -->
    <com.tdpham.games.hub.BackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.5" />

    <!-- Retro Scanline Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scanline_pattern"
        android:alpha="0.1" />

    <LinearLayout
        android:id="@+id/splash_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/splash_logo"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/ic_splash_emblem"
            android:elevation="12dp" />

        <TextView
            android:id="@+id/splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="44sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:shadowColor="#8000E5FF"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="14" />

        <ProgressBar
            android:id="@+id/splash_loader"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="220dp"
            android:layout_height="5dp"
            android:layout_marginTop="32dp"
            android:indeterminate="true"
            android:indeterminateTint="#00E5FF" />

        <TextView
            android:id="@+id/splash_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/supported_devices_hint"
            android:textColor="#78909C"
            android:textSize="14sp"
            android:letterSpacing="0.1" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:text="@string/retro_game_studio"
        android:textColor="#546E7A"
        android:textSize="12sp"
        android:letterSpacing="0.25"
        android:textAllCaps="true" />

</FrameLayout>
