<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="440dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/dialog_background"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="28dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Avatar Preview -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="12dp">

        <View
            android:id="@+id/hero_menu_avatar_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/avatar_circle_placeholder" />

        <ImageView
            android:id="@+id/hero_menu_avatar_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_hero_knight"
            app:tint="#00E676" />
    </FrameLayout>

    <!-- Active Hero Label Badge -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ACTIVE HERO"
        android:textColor="#FFD700"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="@drawable/bg_reward_pill_tag"
        android:layout_marginBottom="8dp" />

    <!-- Hero Name -->
    <TextView
        android:id="@+id/tv_hero_menu_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="360dp"
        android:maxLines="1"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="@string/placeholder_name"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginBottom="20dp" />

    <!-- Edit Hero Option (Default Focus) -->
    <Button
        android:id="@+id/btn_hero_menu_edit"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="@string/edit_profile"
        android:background="@drawable/bg_btn_green_selector"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"
        android:elevation="4dp"
        android:focusable="true"
        android:nextFocusUp="@+id/btn_hero_menu_cancel"
        android:nextFocusDown="@+id/btn_hero_menu_switch"
        android:layout_marginBottom="10dp" />

    <!-- Switch Hero Option -->
    <Button
        android:id="@+id/btn_hero_menu_switch"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/switch_profile"
        android:background="@drawable/bg_btn_neutral_selector"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:focusable="true"
        android:nextFocusUp="@+id/btn_hero_menu_edit"
        android:nextFocusDown="@+id/btn_hero_menu_cancel"
        android:layout_marginBottom="10dp" />

    <!-- Cancel Button -->
    <Button
        android:id="@+id/btn_hero_menu_cancel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/back"
        android:background="@drawable/bg_btn_neutral_selector"
        android:textColor="#B0BEC5"
        android:textSize="13sp"
        android:textStyle="bold"
        android:focusable="true"
        android:nextFocusUp="@+id/btn_hero_menu_switch"
        android:nextFocusDown="@+id/btn_hero_menu_edit" />

</LinearLayout>
