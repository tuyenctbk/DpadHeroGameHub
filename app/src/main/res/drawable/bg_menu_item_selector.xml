<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: Vibrant Electric Cyan with bold white border -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#00E5FF" />
            <corners android:radius="14dp" />
            <stroke
                android:width="3dp"
                android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- Hovered state -->
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <solid android:color="#00B0FF" />
            <corners android:radius="14dp" />
            <stroke
                android:width="2dp"
                android:color="#E0F7FA" />
        </shape>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#0091EA" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Default state: Clean, cohesive dark slate glass -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A2233" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1.5dp"
                android:color="#2D3A52" />
        </shape>
    </item>
</selector>
